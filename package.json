{
  "name": "figma-chatbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && vite build --mode plugin && vite build --mode ui",
    "dev": "vite --mode ui",
    "typecheck": "tsc --noEmit -p tsconfig.plugin.json && tsc --noEmit -p tsconfig.ui.json",
    "watch": "vite build --mode plugin --watch & vite build --mode ui --watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.111.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/openai-compatible": "^2.0.70",
    "ai": "^7.0.77",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
